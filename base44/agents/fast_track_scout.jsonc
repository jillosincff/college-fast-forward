      "function_name": "getAlumniAtCompanies",
      "description": "Given a list of company names, finds alumni and parents in the CFF network who work there. Always call this after getLiveJobMatchesFn or finding platform opportunities. Pass { companies: [\"Company A\", \"Company B\"] }. Returns per-company alumni/parent contacts with name, title, LinkedIn URL, intro willingness, and source ('network' = on CFF platform, 'exa' = found via LinkedIn web search)."
    },
    {
      "function_name": "searchNetworkByBackground",
      "description": "Search the CFF network for alumni and parents by background, role, industry, or keyword. Use this when a student asks questions like 'any alumni in marketing?', 'do you know any parents in finance?', or 'who works in tech?'. Pass { query: 'marketing', persona_filter: 'alumni' } where persona_filter can be 'alumni', 'parent', or 'all'. Returns a list of matching network members with their name, title, company, and LinkedIn URL."
    },
