{
  "name": "Nightly Job Cache Bust \u2014 Daily (4:00 AM ET)",
  "description": "Clears every student's job_leads_cache before they wake up so the first dashboard visit each day forces a fresh live JSearch fetch. Runs before the 4:30 AM overnight prep so that run also sees fresh jobs.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 8 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "nightly_job_cache_bust_daily_4_00_am_et",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "nightlyJobRefresh",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
