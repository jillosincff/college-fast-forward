{
  "name": "InviteRequest",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Full name of requester"
    },
    "email": {
      "type": "string",
      "description": "Email address requesting access"
    },
    "full_name": {
      "type": "string",
      "description": "Full name of requester (legacy)"
    },
    "role": {
      "type": "string",
      "enum": [
        "alumni",
        "parent"
      ],
      "description": "The persona role to assign (alumni or parent)"
    },
    "user_type": {
      "type": "string",
      "enum": [
        "uf_student",
        "uf_alumni",
        "uf_parent"
      ],
      "description": "Type of user requesting access (legacy)"
    },
    "student_name": {
      "type": "string",
      "description": "Name of the student (for parent requests)"
    },
    "grad_year": {
      "type": "string",
      "description": "Graduation year (for alumni requests)"
    },
    "how_heard": {
      "type": "string",
      "description": "How they heard about Gator Network"
    },
    "reason": {
      "type": "string",
      "description": "Why they want to join"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Additional details about the invite request"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Status of the request"
    },
    "approved_by": {
      "type": "string",
      "description": "Admin who approved/rejected"
    },
    "invite_code_generated": {
      "type": "string",
      "description": "The invite code generated upon approval"
    }
  },
  "required": [
    "email",
    "role"
  ],
  "rls": {
    "read": {},
    "write": {}
  }
}