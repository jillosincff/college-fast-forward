{
  "name": "User",
  "type": "object",
  "properties": {
    "persona": {
      "type": "string",
      "enum": [
        "student",
        "parent",
        "alumni",
        "gator"
      ],
      "description": "User type / role"
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "User roles"
    },
    "resume_url": {
      "type": "string",
      "description": "URL to user's uploaded resume file"
    },
    "resume_filename": {
      "type": "string",
      "description": "Original filename of uploaded resume"
    },
    "resume_score": {
      "type": "number",
      "description": "ATS resume score from analysis (0-100)"
    },
    "referral_code_used": {
      "type": "string",
      "description": "Referral code this user signed up with (from a ?ref__= referral link)"
    },
    "referral_used_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the referral code was attributed to this user"
    },
    "utm_source": {
      "type": "string",
      "description": "First-touch UTM source captured at signup (e.g. tiktok, reddit, seo). First-touch wins \u2014 never overwritten."
    },
    "utm_medium": {
      "type": "string",
      "description": "First-touch UTM medium captured at signup (e.g. organic, paid)"
    },
    "utm_campaign": {
      "type": "string",
      "description": "First-touch UTM campaign captured at signup"
    },
    "utm_content": {
      "type": "string",
      "description": "First-touch UTM content captured at signup"
    },
    "utm_term": {
      "type": "string",
      "description": "First-touch UTM term captured at signup"
    },
    "signup_source": {
      "type": "string",
      "description": "Derived attribution at signup: utm_source if present, else 'referral' if a referral code exists, else 'direct'"
    },
    "referral_code": {
      "type": "string",
      "description": "Normalized referral code at signup \u2014 ambassador (?ref__=) or parent ref, whichever is present. First-touch, never overwritten."
    },
    "linkedin_optimization": {
      "type": "object",
      "properties": {
        "headline": {
          "type": "string",
          "description": "Optimized LinkedIn headline"
        },
        "about": {
          "type": "string",
          "description": "Optimized LinkedIn about/summary section"
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Top 5 skills to add to LinkedIn"
        }
      },
      "description": "AI-generated LinkedIn profile optimization from onboarding"
    },
    "linkedin_optimization_generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the LinkedIn optimization was generated"
    },
    "exclude_from_analytics": {
      "type": "boolean",
      "default": false,
      "description": "Admins set true for test / seeded / internal accounts so they never affect TTFMP metrics"
    },
    "first_meaningful_progress_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the student's first completed meaningful job-search action. Permanent \u2014 never overwritten."
    },
    "first_meaningful_progress_type": {
      "type": "string",
      "description": "Which event type created first meaningful progress"
    },
    "first_meaningful_progress_event_id": {
      "type": "string",
      "description": "Id of the StudentAnalyticsEvent that created first meaningful progress"
    },
    "ttfmp_seconds": {
      "type": "number",
      "description": "Exact seconds between account creation and first meaningful progress"
    },
    "ttfmp_under_10_minutes": {
      "type": "boolean",
      "description": "True when ttfmp_seconds <= 600"
    },
    "ttfmp_backfilled": {
      "type": "boolean",
      "default": false,
      "description": "True when TTFMP was reconstructed from historical records rather than live-tracked"
    }
  },
  "required": [
    "persona"
  ]
}