{
  "name": "User",
  "type": "object",
  "properties": {
    "persona": {
      "type": "string",
      "enum": [
        "student",
        "parent",
        "alumni",
        "gator"
      ],
      "description": "User type / role"
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "User roles"
    },
    "linkedin_optimization": {
      "type": "object",
      "properties": {
        "headline": {
          "type": "string",
          "description": "Optimized LinkedIn headline"
        },
        "about": {
          "type": "string",
          "description": "Optimized LinkedIn about/summary section"
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Top 5 skills to add to LinkedIn"
        }
      },
      "description": "AI-generated LinkedIn profile optimization from onboarding"
    },
    "linkedin_optimization_generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the LinkedIn optimization was generated"
    }
  }
}