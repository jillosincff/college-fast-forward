{
  "name": "User",
  "type": "object",
  "properties": {
    "persona": {
      "type": "string",
      "enum": [
        "student",
        "parent",
        "alumni",
        "gator"
      ],
      "description": "User type / role"
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "User roles"
    },
    "onboarding_completed": {
      "type": "boolean",
      "default": false,
      "description": "Whether onboarding is complete"
    },
    "onboarding_completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When onboarding was completed"
    },
    "onboarding_question_answered": {
      "type": "boolean",
      "default": false,
      "description": "Whether a question was answered during onboarding"
    },
    "onboarding_flow_type": {
      "type": "string",
      "description": "Type of onboarding flow used"
    },
    "onboarding_referral_submitted": {
      "type": "boolean",
      "default": false,
      "description": "Whether a referral was submitted during onboarding"
    },
    "pledge_taken": {
      "type": "boolean",
      "default": false,
      "description": "Whether the parent took the CFF Pledge"
    },
    "pledge_taken_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the parent took the pledge"
    },
    "first_question_shown": {
      "type": "boolean",
      "default": false,
      "description": "Whether the post-pledge first question screen was shown"
    },
    "first_question_answered": {
      "type": "boolean",
      "default": false,
      "description": "Whether the parent answered on the post-pledge screen"
    },
    "visible_in_directory": {
      "type": "boolean",
      "default": false,
      "description": "Whether visible in the Gator Directory"
    },
    "current_position": {
      "type": "string",
      "description": "Current job title"
    },
    "current_company": {
      "type": "string",
      "description": "Current company"
    },
    "job_title": {
      "type": "string",
      "description": "Job title"
    },
    "company": {
      "type": "string",
      "description": "Company"
    },
    "years_experience": {
      "type": "string",
      "description": "Years of experience"
    },
    "industries": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Industries"
    },
    "industry": {
      "type": "string",
      "description": "Primary industry"
    },
    "ways_to_help": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Ways willing to help"
    },
    "expertise_areas": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Areas of expertise"
    },
    "help_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Types of help offered"
    },
    "invite_code_used": {
      "type": "string",
      "description": "Invite code used to join"
    },
    "profile_image": {
      "type": "string",
      "description": "URL of profile image"
    },
    "linkedin_url": {
      "type": "string",
      "description": "LinkedIn profile URL"
    },
    "title": {
      "type": "string",
      "description": "User's professional title"
    },
    "bio": {
      "type": "string",
      "description": "Short bio"
    },
    "graduation_year": {
      "type": "string",
      "description": "Graduation year"
    },
    "major": {
      "type": "string",
      "description": "Major field of study"
    },
    "minor": {
      "type": "string",
      "description": "Minor field of study"
    },
    "pre_track": {
      "type": "string",
      "description": "Pre-professional track"
    },
    "location": {
      "type": "string",
      "description": "Location"
    },
    "school": {
      "type": "string",
      "description": "Primary school affiliation"
    },
    "university": {
      "type": "string",
      "description": "University (legacy field)"
    },
    "schools": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "All school affiliations"
    },
    "grad_school": {
      "type": "string",
      "description": "Graduate school name if applicable"
    },
    "grad_school_type": {
      "type": "string",
      "enum": [
        "mba",
        "law",
        "med",
        "masters",
        "phd",
        "other"
      ],
      "description": "Type of graduate program"
    },
    "grad_school_status": {
      "type": "string",
      "enum": [
        "enrolled",
        "completed"
      ],
      "description": "Current or completed grad program"
    },
    "is_founding_member": {
      "type": "boolean",
      "default": false,
      "description": "Whether user is a founding member"
    },
    "referral_code": {
      "type": "string",
      "description": "Unique referral code"
    },
    "referred_by": {
      "type": "string",
      "description": "Referral code that referred this user"
    },
    "ambassador_code": {
      "type": "string",
      "description": "Ambassador code used during signup"
    },
    "student_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Linked student emails"
    },
    "parent_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Linked parent emails"
    },
    "family_group_id": {
      "type": "string",
      "description": "Family group identifier"
    },
    "profile_slug": {
      "type": "string",
      "description": "URL-friendly profile slug"
    },
    "push_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether push notifications are enabled"
    },
    "last_active_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last activity timestamp"
    },
    "reengagement_status": {
      "type": "string",
      "description": "Re-engagement email status"
    },
    "reengagement_unsubscribed": {
      "type": "boolean",
      "default": false,
      "description": "Whether user unsubscribed from re-engagement"
    },
    "is_fastiq": {
      "type": "boolean",
      "default": false,
      "description": "Whether user has FastIQ access"
    },
    "fastiq_setup_complete": {
      "type": "boolean",
      "default": false,
      "description": "Whether FastIQ onboarding is complete"
    },
    "subscription_status": {
      "type": "string",
      "description": "Stripe subscription status (e.g. active, trialing, canceled, trial)"
    },
    "membership_tier": {
      "type": "string",
      "description": "Membership tier (e.g. fastiq, fastiq_trial, free)"
    },
    "trial_start_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the 7-day free trial started"
    },
    "trial_end_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the 7-day free trial ends"
    },
    "trial_status": {
      "type": "string",
      "enum": [
        "not_started",
        "active",
        "expired"
      ],
      "default": "not_started",
      "description": "Current status of the free trial"
    },
    "fastiq_trial_active": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user is currently on an active 7-day FastIQ trial"
    },
    "last_day5_email_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the trial Day 5 reminder email was last sent"
    },
    "last_day7_email_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the trial Day 7 (trial ending today) email was last sent"
    },
    "last_day8_email_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the trial Day 8 (trial ended) email was last sent"
    },
    "last_parent_day6_email_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the Day 6 parent nudge email was last sent (stored on the parent record)"
    },
    "gifted_by_parent_email": {
      "type": "string",
      "description": "Email of the parent who gifted FastIQ to this student"
    },
    "linked_parent_name": {
      "type": "string",
      "description": "First name of the parent who gifted FastIQ"
    },
    "pending_fastiq_gift_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Student emails pending a FastIQ gift once they sign up"
    },
    "career_goals": {
      "type": "object",
      "description": "Structured career goals saved from FastIQ career goals chat",
      "default": {}
    },
    "career_goals_conversation": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": [],
      "description": "Saved conversation history from the career goals chat"
    },
    "career_goals_conversation_updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the career goals conversation was last updated"
    },
    "preliminary_archetype": {
      "type": "string",
      "description": "Career archetype inferred from goals conversation"
    },
    "saved_leads": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": [],
      "description": "Leads saved by the student from the Leads section"
    },
    "alumni_explorer_cache": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": [],
      "description": "Cached alumni clusters from the alumni explorer"
    },
    "alumni_explorer_cached_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the alumni explorer cache was last populated"
    },
    "alumni_seniority": {
      "type": "string",
      "enum": [
        "recent_grad",
        "established"
      ],
      "description": "Alumni seniority type for routing"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Professional skills"
    },
    "location_city": {
      "type": "string",
      "description": "City"
    },
    "location_state": {
      "type": "string",
      "description": "State"
    },
    "can_provide_referrals": {
      "type": "boolean",
      "default": false,
      "description": "Whether user can provide referrals"
    },
    "intro_willingness": {
      "type": "string",
      "description": "Willingness to make intros (yes, occasionally, not_now)"
    },
    "intro_availability": {
      "type": "string",
      "description": "Availability for introductions"
    },
    "mentorship_topics": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Topics user can mentor on"
    },
    "enriched_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the profile was last enriched via LinkedIn/Proxycurl"
    },
    "profile_image_url": {
      "type": "string",
      "description": "Profile image URL (enriched)"
    },
    "resume_url": {
      "type": "string",
      "description": "URL of uploaded resume"
    },
    "alumni_search_used": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has used their free alumni search"
    },
    "company_intel_viewed": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has visited the Company Intel tab"
    },
    "leads_viewed": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has viewed their leads"
    },
    "platform_visit_count": {
      "type": "number",
      "default": 0,
      "description": "Number of platform page visits tracked"
    },
    "target_companies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Target companies saved on the user profile"
    },
    "target_industries": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Target industries"
    },
    "school_code": {
      "type": "string",
      "description": "School code for school isolation (must never be overwritten)"
    },
    "school_name": {
      "type": "string",
      "description": "Human-readable school name"
    },
    "career_archetype": {
      "type": "string",
      "description": "Career archetype from assessment"
    },
    "resume_score": {
      "type": "number",
      "description": "Resume quality score"
    },
    "has_searched_alumni": {
      "type": "boolean",
      "default": false,
      "description": "Whether user has searched alumni"
    },
    "has_messaged_connection": {
      "type": "boolean",
      "default": false,
      "description": "Whether user has messaged a connection"
    },
    "has_done_mock_interview": {
      "type": "boolean",
      "default": false,
      "description": "Whether user has done a mock interview"
    },
    "stripe_customer_id": {
      "type": "string",
      "description": "Stripe customer ID"
    },
    "stripe_subscription_id": {
      "type": "string",
      "description": "Stripe subscription ID"
    },
    "founding_offer_redeemed": {
      "type": "boolean",
      "default": false,
      "description": "Whether the founding member offer was redeemed"
    },
    "founding_offer_redeemed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the founding offer was redeemed"
    },
    "founding_member_plan": {
      "type": "string",
      "description": "Plan name for founding members"
    },
    "founding_offer_home_seen": {
      "type": "boolean",
      "default": false,
      "description": "Whether the founding offer home card has been shown"
    },
    "current_period_end": {
      "type": "string",
      "format": "date-time",
      "description": "When the current Stripe billing period ends"
    },
    "payment_failed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the last payment failure occurred"
    },
    "payment_failure_count": {
      "type": "number",
      "default": 0,
      "description": "Number of consecutive payment failures"
    },
    "fastiq_active": {
      "type": "boolean",
      "default": false,
      "description": "Whether FastIQ is currently active for this user"
    },
    "family_id": {
      "type": "string",
      "description": "ID of the Family record this user belongs to"
    },
    "weekly_outreach_tokens": {
      "type": "number",
      "default": 3,
      "description": "Weekly outreach tokens available (replenished each week)"
    },
    "referral_bonus_tokens": {
      "type": "number",
      "default": 0,
      "description": "Bonus outreach tokens earned via friend referrals \u2014 credited when a referred friend reaches the school-selection milestone"
    }
  },
  "required": []
}