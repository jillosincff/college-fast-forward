{
  "name": "User",
  "type": "object",
  "properties": {
    "persona": {
      "type": "string",
      "enum": [
        "student",
        "parent",
        "alumni",
        "gator"
      ],
      "description": "User type / role"
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "User roles"
    },
    "resume_url": {
      "type": "string",
      "description": "URL to user's uploaded resume file"
    },
    "resume_filename": {
      "type": "string",
      "description": "Original filename of uploaded resume"
    },
    "resume_score": {
      "type": "number",
      "description": "ATS resume score from analysis (0-100)"
    },
    "referral_code_used": {
      "type": "string",
      "description": "Referral code this user signed up with (from a ?ref__= referral link)"
    },
    "referral_used_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the referral code was attributed to this user"
    },
    "linkedin_optimization": {
      "type": "object",
      "properties": {
        "headline": {
          "type": "string",
          "description": "Optimized LinkedIn headline"
        },
        "about": {
          "type": "string",
          "description": "Optimized LinkedIn about/summary section"
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Top 5 skills to add to LinkedIn"
        }
      },
      "description": "AI-generated LinkedIn profile optimization from onboarding"
    },
    "linkedin_optimization_generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the LinkedIn optimization was generated"
    }
  },
  "required": [
    "persona"
  ]
}