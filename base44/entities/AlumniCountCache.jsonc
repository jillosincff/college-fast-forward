{
  "name": "AlumniCountCache",
  "type": "object",
  "properties": {
    "cache_key": {
      "type": "string",
      "description": "Unique key: alumni_{company}_{school}"
    },
    "data": {
      "type": "object",
      "description": "Cached alumni count result from Proxycurl"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Notes about this cache entry"
    },
    "scraped_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this cache entry was last refreshed"
    }
  },
  "required": [
    "cache_key"
  ],
  "rls": {
    "read": {},
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}