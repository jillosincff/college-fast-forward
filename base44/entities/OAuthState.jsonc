{
  "name": "OAuthState",
  "type": "object",
  "properties": {
    "token": {
      "type": "string",
      "description": "Unique token for OAuth callback"
    },
    "role": {
      "type": "string",
      "description": "User role (gator, parent, alumni)"
    },
    "invite_code": {
      "type": "string",
      "description": "Parent invite code (if applicable)"
    },
    "email": {
      "type": "string",
      "description": "User email (if provided)"
    },
    "referral_code": {
      "type": "string",
      "description": "Referral code (if applicable)"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Context or notes about this OAuth state"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this state expires (5 minutes)"
    },
    "used": {
      "type": "boolean",
      "default": false,
      "description": "Whether this token has been used"
    }
  },
  "required": [
    "token",
    "role",
    "expires_at"
  ],
  "rls": {
    "read": {},
    "write": {}
  }
}