{
  "name": "ProAgentConversation",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the student"
    },
    "role": {
      "type": "string",
      "description": "Message sender role (user or assistant)"
    },
    "content": {
      "type": "string",
      "description": "Text content of the message"
    },
    "message_type": {
      "type": "string",
      "description": "Type of message for rich card rendering (text, company_intel, alumni_card, outreach_draft, roadmap)"
    },
    "payload": {
      "type": "string",
      "description": "JSON string of structured data for rich cards"
    },
    "conversation_id": {
      "type": "string",
      "description": "Groups messages into conversation sessions"
    }
  },
  "required": [
    "user_email",
    "role",
    "content"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}