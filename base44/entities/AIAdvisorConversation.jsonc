{
  "name": "AIAdvisorConversation",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User who started the conversation"
    },
    "user_email": {
      "type": "string",
      "description": "User email for easy lookup"
    },
    "conversation_type": {
      "type": "string",
      "enum": [
        "salary",
        "interview",
        "career",
        "negotiation",
        "general"
      ],
      "description": "Type of conversation"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Summary or topic of the conversation"
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          }
        }
      },
      "default": [],
      "description": "Conversation messages"
    },
    "was_helpful": {
      "type": "boolean",
      "description": "User rated as helpful"
    },
    "led_to_mentor_connection": {
      "type": "boolean",
      "default": false
    },
    "mentor_connected_id": {
      "type": "string",
      "description": "ID of mentor if connected"
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_id": "{{user.id}}"
        },
        {
          "user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "user_id": "{{user.id}}"
        },
        {
          "user_email": "{{user.email}}"
        }
      ]
    }
  }
}