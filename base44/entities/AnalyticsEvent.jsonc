{
  "name": "AnalyticsEvent",
  "type": "object",
  "properties": {
    "event_name": {
      "type": "string",
      "description": "Event name e.g. fastiq_trial_started, fastiq_feature_used, upgrade_clicked"
    },
    "user_id": {
      "type": "string",
      "description": "ID of the user who triggered the event"
    },
    "user_email": {
      "type": "string",
      "description": "Email of the user for quick lookups"
    },
    "school_code": {
      "type": "string",
      "description": "School code or name for segmentation"
    },
    "persona": {
      "type": "string",
      "enum": [
        "student",
        "parent",
        "alumni",
        "gator"
      ],
      "description": "Persona of the user at time of event"
    },
    "properties": {
      "type": "object",
      "description": "Flexible JSON \u2014 event-specific metadata",
      "default": {}
    }
  },
  "required": [
    "event_name",
    "user_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {}
  }
}