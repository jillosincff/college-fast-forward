{
  "name": "InterviewQuestion",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID of user who submitted"
    },
    "is_anonymous": {
      "type": "boolean",
      "default": true,
      "description": "Whether submission is anonymous"
    },
    "submitter_name": {
      "type": "string",
      "description": "Name to display if not anonymous"
    },
    "submitter_title": {
      "type": "string",
      "description": "Title to display if not anonymous"
    },
    "company": {
      "type": "string",
      "description": "Company name"
    },
    "company_normalized": {
      "type": "string",
      "description": "Cleaned company name for searching"
    },
    "role": {
      "type": "string",
      "description": "Role/position interviewed for"
    },
    "role_normalized": {
      "type": "string",
      "description": "Cleaned role for searching"
    },
    "experience_level": {
      "type": "string",
      "enum": [
        "intern",
        "entry",
        "mid",
        "senior"
      ],
      "description": "Experience level for the role"
    },
    "question_type": {
      "type": "string",
      "enum": [
        "behavioral",
        "case",
        "technical",
        "product",
        "system_design",
        "other"
      ],
      "description": "Type of interview question"
    },
    "question_text": {
      "type": "string",
      "description": "The actual interview question"
    },
    "answer_tips": {
      "type": "string",
      "description": "Tips for answering this question"
    },
    "interview_date": {
      "type": "string",
      "description": "When the interview happened (e.g., Q1 2025)"
    },
    "upvote_count": {
      "type": "number",
      "default": 0,
      "description": "How many found this helpful"
    },
    "confirmation_count": {
      "type": "number",
      "default": 0,
      "description": "How many others were asked this question"
    },
    "is_verified": {
      "type": "boolean",
      "default": false,
      "description": "Admin verified"
    },
    "is_visible": {
      "type": "boolean",
      "default": true,
      "description": "Whether visible to users"
    }
  },
  "required": [
    "company",
    "role",
    "experience_level",
    "question_type",
    "question_text"
  ],
  "rls": {
    "read": {},
    "write": {
      "$or": [
        {
          "user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}