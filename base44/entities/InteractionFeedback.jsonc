{
  "name": "InteractionFeedback",
  "type": "object",
  "properties": {
    "interaction_log_id": {
      "type": "string",
      "description": "ID of the InteractionLog this feedback is for"
    },
    "student_id": {
      "type": "string",
      "description": "ID of the student being reviewed"
    },
    "student_email": {
      "type": "string",
      "description": "Email of the student"
    },
    "student_name": {
      "type": "string",
      "description": "Display name of the student"
    },
    "reviewer_id": {
      "type": "string",
      "description": "ID of the reviewer (parent/alumni/peer)"
    },
    "reviewer_email": {
      "type": "string",
      "description": "Email of the reviewer"
    },
    "reviewer_name": {
      "type": "string",
      "description": "Display name of the reviewer"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Summary of this feedback session"
    },
    "positive_attributes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "came_prepared",
          "asked_great_questions",
          "strong_communicator",
          "professional_demeanor",
          "followed_up",
          "would_refer",
          "would_hire"
        ]
      },
      "default": [],
      "description": "Positive attributes observed during the interaction"
    },
    "growth_attributes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "seemed_unprepared",
          "needs_communication_help",
          "no_follow_up",
          "needs_resume_help",
          "didnt_show_up"
        ]
      },
      "default": [],
      "description": "Areas where the student could improve"
    },
    "overall_impression": {
      "type": "string",
      "enum": [
        "excellent",
        "great",
        "good",
        "still_warming_up"
      ],
      "description": "Overall impression of the student"
    },
    "open_feedback": {
      "type": "string",
      "description": "Free-form feedback text from the reviewer"
    },
    "recommend_coaching": {
      "type": "boolean",
      "default": false,
      "description": "PRIVATE \u2014 whether the reviewer recommends coaching for the student. Never shown to the student."
    },
    "feedback_visible": {
      "type": "boolean",
      "default": true,
      "description": "Whether the feedback is visible to the student"
    }
  },
  "required": [
    "interaction_log_id",
    "student_id",
    "student_email",
    "reviewer_id",
    "reviewer_email",
    "overall_impression"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "reviewer_id": "{{user.id}}"
        },
        {
          "reviewer_email": "{{user.email}}"
        },
        {
          "student_id": "{{user.id}}"
        },
        {
          "student_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "reviewer_id": "{{user.id}}"
        },
        {
          "reviewer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}