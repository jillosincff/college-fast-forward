{
  "name": "LightweightResponder",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Verified email address"
    },
    "first_name": {
      "type": "string",
      "description": "First name"
    },
    "role": {
      "type": "string",
      "enum": [
        "parent",
        "alumni",
        "student",
        "other"
      ],
      "default": "other",
      "description": "Self-reported relationship to UF"
    },
    "created_via": {
      "type": "string",
      "default": "shared_question",
      "description": "How this user was created"
    },
    "source_question_id": {
      "type": "string",
      "description": "First question they responded to"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Notes about this lightweight responder"
    },
    "last_verified_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last time email was verified"
    },
    "verification_count": {
      "type": "number",
      "default": 1,
      "description": "How many times they've verified"
    },
    "response_count": {
      "type": "number",
      "default": 0,
      "description": "Number of answers submitted"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this responder is active"
    },
    "is_flagged": {
      "type": "boolean",
      "default": false,
      "description": "Flagged for review"
    },
    "converted_to_user_id": {
      "type": "string",
      "description": "If they later created a full account"
    }
  },
  "required": [
    "email",
    "first_name"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}