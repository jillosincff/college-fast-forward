{
  "name": "RecommendationOutcome",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Student the recommendation was shown to"
    },
    "user_email": {
      "type": "string",
      "description": "Student email \u2014 used for lookups and RLS"
    },
    "job_key": {
      "type": "string",
      "description": "Dedupe key: company||role (lowercase)"
    },
    "job_id": {
      "type": "string",
      "description": "Source job identifier, if any"
    },
    "company_name": {
      "type": "string",
      "description": "Company name"
    },
    "job_title": {
      "type": "string",
      "description": "Role title"
    },
    "recommendation_level": {
      "type": "string",
      "enum": [
        "best",
        "good",
        "low"
      ],
      "description": "Opportunity tier CLIFF assigned"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "pursue",
        "consider",
        "skip"
      ],
      "description": "CLIFF's opinionated verdict"
    },
    "confidence_before": {
      "type": "number",
      "description": "Verdict score at recommendation time"
    },
    "confidence_after": {
      "type": "number",
      "description": "Adjusted confidence after outcome grading (future use)"
    },
    "pursued": {
      "type": "boolean",
      "default": false,
      "description": "Student took any action on this job"
    },
    "applied": {
      "type": "boolean",
      "default": false,
      "description": "Student applied"
    },
    "interview": {
      "type": "boolean",
      "default": false,
      "description": "Student got an interview"
    },
    "offer": {
      "type": "boolean",
      "default": false,
      "description": "Student got an offer"
    },
    "accepted": {
      "type": "boolean",
      "default": false,
      "description": "Student accepted the offer"
    },
    "rejected": {
      "type": "boolean",
      "default": false,
      "description": "Application rejected or went nowhere"
    },
    "student_feedback": {
      "type": "string",
      "enum": [
        "resume_screen",
        "gpa_requirement",
        "technical_interview",
        "position_filled",
        "no_response",
        "other"
      ],
      "description": "Student's answer to 'What happened?'"
    },
    "reason_if_known": {
      "type": "string",
      "description": "Free-text detail from the student"
    },
    "follow_up_completed": {
      "type": "boolean",
      "default": false,
      "description": "Student answered the feedback prompt"
    },
    "school_code": {
      "type": "string",
      "description": "Student's school at recommendation time"
    },
    "plan": {
      "type": "string",
      "description": "free or pro at recommendation time"
    }
  },
  "required": [
    "user_id",
    "user_email",
    "job_key",
    "company_name",
    "recommendation_level"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}