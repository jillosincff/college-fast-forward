{
  "name": "FastTrackProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID of the student (unique, one per student)"
    },
    "user_email": {
      "type": "string",
      "description": "Email of the student"
    },
    "user_name": {
      "type": "string",
      "description": "Display name of the student"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Notes or summary about this student's fast track profile"
    },
    "graduation_year": {
      "type": "number",
      "description": "Expected graduation year"
    },
    "graduation_semester": {
      "type": "string",
      "enum": [
        "Fall",
        "Spring",
        "Summer"
      ],
      "description": "Expected graduation semester"
    },
    "target_industries": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Industries the student is targeting"
    },
    "current_tier": {
      "type": "string",
      "enum": [
        "just_getting_started",
        "building_momentum",
        "rising",
        "fast_tracked"
      ],
      "default": "just_getting_started",
      "description": "Current Fast Track tier"
    },
    "tier_updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the tier was last updated"
    },
    "total_interactions": {
      "type": "number",
      "default": 0,
      "description": "Total number of interactions scheduled"
    },
    "completed_interactions": {
      "type": "number",
      "default": 0,
      "description": "Number of interactions completed"
    },
    "no_show_count": {
      "type": "number",
      "default": 0,
      "description": "Number of times the student no-showed"
    },
    "positive_feedback": {
      "type": "number",
      "default": 0,
      "description": "Number of positive feedback received (excellent or great)"
    },
    "total_feedback": {
      "type": "number",
      "default": 0,
      "description": "Total number of feedback received"
    },
    "avg_impression_score": {
      "type": "number",
      "default": 0,
      "description": "Average overall impression score (0-100)"
    },
    "follow_up_rate": {
      "type": "number",
      "default": 0,
      "description": "Percentage of interactions where student followed up (0-100)"
    },
    "reliability_score": {
      "type": "number",
      "default": 100,
      "description": "Reliability score as percentage (0-100)"
    },
    "would_refer_count": {
      "type": "number",
      "default": 0,
      "description": "Number of reviewers who would refer this student"
    },
    "would_hire_count": {
      "type": "number",
      "default": 0,
      "description": "Number of reviewers who would hire this student"
    },
    "coaching_recommended": {
      "type": "boolean",
      "default": false,
      "description": "Whether coaching has been recommended by a reviewer"
    },
    "coaching_completed": {
      "type": "boolean",
      "default": false,
      "description": "Whether the student has completed coaching"
    },
    "fast_tracked_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the student reached fast_tracked tier"
    },
    "weekly_activity_streak": {
      "type": "number",
      "default": 0,
      "description": "Number of consecutive weeks with activity"
    },
    "last_activity_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the student last had activity"
    },
    "companies_matched_to": {
      "type": "string",
      "description": "Comma-separated list of companies the student has been matched to"
    },
    "urgency_tier": {
      "type": "string",
      "enum": [
        "cruising",
        "time_to_move",
        "dont_miss_this",
        "all_hands_on_deck"
      ],
      "default": "cruising",
      "description": "Urgency level based on graduation timeline"
    }
  },
  "required": [
    "user_id",
    "user_email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_id": "{{user.id}}"
        },
        {
          "user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "user_id": "{{user.id}}"
        },
        {
          "user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}