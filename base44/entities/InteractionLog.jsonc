{
  "name": "InteractionLog",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string",
      "description": "ID of the student in the interaction"
    },
    "student_email": {
      "type": "string",
      "description": "Email of the student"
    },
    "student_name": {
      "type": "string",
      "description": "Display name of the student"
    },
    "helper_id": {
      "type": "string",
      "description": "ID of the helper (parent/alumni/peer)"
    },
    "helper_email": {
      "type": "string",
      "description": "Email of the helper"
    },
    "helper_name": {
      "type": "string",
      "description": "Display name of the helper"
    },
    "helper_type": {
      "type": "string",
      "enum": [
        "parent",
        "alumni",
        "peer"
      ],
      "description": "Type of helper"
    },
    "interaction_type": {
      "type": "string",
      "enum": [
        "call",
        "video",
        "coffee_chat",
        "resume_review",
        "mock_interview",
        "intro"
      ],
      "description": "Type of interaction that occurred"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Details about what happened during this interaction"
    },
    "related_request_id": {
      "type": "string",
      "description": "ID of the related HelpRequest or JobRequest (optional)"
    },
    "related_offer_id": {
      "type": "string",
      "description": "ID of the related HelpOffer or IntroOffer (optional)"
    },
    "scheduled_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the interaction is scheduled"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the interaction was completed"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "completed",
        "no_show_student",
        "no_show_helper",
        "cancelled"
      ],
      "default": "scheduled",
      "description": "Current status of the interaction"
    },
    "no_show_reason": {
      "type": "string",
      "description": "Reason provided if someone didn't show up"
    }
  },
  "required": [
    "student_id",
    "student_email",
    "helper_id",
    "helper_email",
    "interaction_type",
    "scheduled_at",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "student_id": "{{user.id}}"
        },
        {
          "student_email": "{{user.email}}"
        },
        {
          "helper_id": "{{user.id}}"
        },
        {
          "helper_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "student_id": "{{user.id}}"
        },
        {
          "student_email": "{{user.email}}"
        },
        {
          "helper_id": "{{user.id}}"
        },
        {
          "helper_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}