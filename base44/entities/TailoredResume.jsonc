{
  "name": "TailoredResume",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the student"
    },
    "source_resume_id": {
      "type": "string",
      "description": "Reference to Resume entity"
    },
    "company_name": {
      "type": "string",
      "description": "Company the resume was tailored for"
    },
    "role_title": {
      "type": "string",
      "description": "Job title the resume was tailored for"
    },
    "job_description_text": {
      "type": "string",
      "description": "The job description text used for tailoring"
    },
    "tailored_content": {
      "type": "string",
      "description": "Full tailored resume text"
    },
    "tailored_resume_json": {
      "type": "string",
      "description": "JSON string of the tailored resume data"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "original": {
            "type": "string"
          },
          "tailored": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "accepted": {
            "type": "boolean"
          }
        }
      },
      "default": [],
      "description": "Detailed changes with accept/reject tracking"
    },
    "original_score": {
      "type": "number",
      "description": "Original resume match score 0-100"
    },
    "ats_score": {
      "type": "number",
      "description": "Tailored ATS match score 0-100"
    },
    "keywords_added": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Keywords added during tailoring"
    },
    "keywords_missing": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Important JD keywords still not in resume"
    },
    "keywords_matched": {
      "type": "number",
      "description": "Number of keywords matched"
    },
    "keywords_total": {
      "type": "number",
      "description": "Total keywords in job description"
    },
    "changes_summary": {
      "type": "string",
      "description": "Summary of what was changed"
    },
    "downloaded_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the PDF was downloaded"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "failed"
      ],
      "default": "completed",
      "description": "Whether this tailoring is still in the batch queue (pending) or done (completed)"
    },
    "available_at": {
      "type": "string",
      "format": "date-time",
      "description": "When a pending tailoring request will be processed (24h queue for free users)"
    },
    "resume_text_snapshot": {
      "type": "string",
      "description": "Snapshot of the original resume text used for tailoring (stored for batch processing)"
    }
  },
  "required": [
    "user_email",
    "company_name",
    "role_title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_email": "{{user.email}}"
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "user_email": "{{user.email}}"
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}