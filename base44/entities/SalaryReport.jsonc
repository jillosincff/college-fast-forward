{
  "name": "SalaryReport",
  "type": "object",
  "properties": {
    "company": {
      "type": "string",
      "description": "Company name"
    },
    "role": {
      "type": "string",
      "description": "Job title or role"
    },
    "industry": {
      "type": "string",
      "description": "Industry category"
    },
    "location": {
      "type": "string",
      "description": "City or metro area"
    },
    "offer_type": {
      "type": "string",
      "enum": [
        "full_time",
        "internship",
        "part_time",
        "contract",
        "co_op"
      ],
      "description": "Type of offer"
    },
    "base_salary": {
      "type": "number",
      "description": "Annual base salary in USD"
    },
    "signing_bonus": {
      "type": "number",
      "description": "One-time signing bonus"
    },
    "hourly_rate": {
      "type": "number",
      "description": "Hourly rate (for internships/part-time)"
    },
    "housing_stipend": {
      "type": "number",
      "description": "Housing/relocation stipend"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Additional context about this salary report"
    },
    "how_they_got_it": {
      "type": "string",
      "enum": [
        "online_application",
        "referral",
        "career_fair",
        "recruiter",
        "networking",
        "other"
      ],
      "description": "How the student got the offer"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the report was submitted"
    }
  },
  "required": [
    "company",
    "role",
    "offer_type"
  ],
  "rls": {
    "read": {},
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}