{
  "name": "CareerWishlist",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string",
      "description": "ID of the student who saved the job title"
    },
    "job_title_id": {
      "type": "string",
      "description": "ID of the saved JobTitleSpotlight"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Notes about why this career was saved"
    }
  },
  "required": [
    "student_id",
    "job_title_id"
  ]
}